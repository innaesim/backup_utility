<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Properties>
        <Property name="logDir">${sys:backup.utility.home:-${sys:user.home}/.backup-utility}/logs</Property>
    </Properties>
    <Appenders>
        <!-- stderr, so command output on stdout stays clean for scripts. -->
        <Console name="Console" target="SYSTEM_ERR">
            <PatternLayout pattern="%d{HH:mm:ss} %-5level %msg%n"/>
        </Console>
        <RollingFile name="File"
                     fileName="${logDir}/backup-utility.log"
                     filePattern="${logDir}/backup-utility-%d{yyyy-MM-dd}-%i.log.gz"
                     ignoreExceptions="true">
            <PatternLayout pattern="%d{ISO8601} %-5level [%t] %c{1} - %msg%n"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="10 MB"/>
                <TimeBasedTriggeringPolicy/>
            </Policies>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>
    </Appenders>
    <Loggers>
        <Logger name="software.amazon" level="WARN"/>
        <Logger name="com.azure" level="WARN"/>
        <!-- Warns about Netty versions on every run, because shading removes the metadata it reads. -->
        <Logger name="com.azure.core.http.netty.implementation.Utility" level="ERROR"/>
        <Logger name="reactor" level="WARN"/>
        <Logger name="io.netty" level="WARN"/>
        <Logger name="net.schmizz" level="WARN"/>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
        </Root>
    </Loggers>
</Configuration>
